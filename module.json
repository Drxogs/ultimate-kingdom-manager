{
  "id": "ultimate-kingdom-manager",
  "title": "Ultimate Kingdom Manager",
  "description": "Kingdom building for Pathfinder 2e Kingmaker that plays like the video game. Every player gets a desk, problems land on it with a deadline, companions take days to sort them out, and your settlements grow while the party is off adventuring. Written with Claude, Anthropic's AI model; see the README for details.",
  "version": "1.0.2",
  "authors": [
    {
      "name": "Drxogs",
      "url": "https://github.com/Drxogs"
    }
  ],
  "url": "https://github.com/Drxogs/ultimate-kingdom-manager",
  "manifest": "https://github.com/Drxogs/ultimate-kingdom-manager/releases/latest/download/module.json",
  "download": "https://github.com/Drxogs/ultimate-kingdom-manager/releases/download/v1.0.2/module.zip",
  "bugs": "https://github.com/Drxogs/ultimate-kingdom-manager/issues",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "7.0.0",
          "verified": "8.6.1"
        }
      }
    ],
    "recommends": [
      {
        "id": "pf2e-kingmaker",
        "type": "module",
        "reason": "Region map, hex data and adventure text for the story import."
      },
      {
        "id": "socketlib",
        "type": "module",
        "reason": "Lets players act on their desks while the GM is connected."
      }
    ],
    "conflicts": [
      {
        "id": "ultimate-kingdom-manager-next",
        "type": "module",
        "reason": "The test build (Next). Enable only one of the two in a world."
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/ukm.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "license": "LICENSE",
  "readme": "README.md",
  "media": [
    {
      "type": "cover",
      "url": "https://raw.githubusercontent.com/Drxogs/ultimate-kingdom-manager/main/media/cover.png"
    },
    {
      "type": "icon",
      "url": "https://raw.githubusercontent.com/Drxogs/ultimate-kingdom-manager/main/media/icon.png"
    }
  ]
}
