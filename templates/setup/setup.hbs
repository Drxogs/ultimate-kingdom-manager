<div class="ukm-setup-body">
  <section class="ukm-status">
    <h3>{{localize "UKM.Setup.Status"}}</h3>
    <ul class="ukm-checklist">
      <li class="{{#if sources.kingmaker}}ok{{else}}warn{{/if}}">
        <i class="fa-solid {{#if sources.kingmaker}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
        {{localize "UKM.Setup.KingmakerModule"}}
      </li>
      <li class="{{#if sources.adventureImported}}ok{{else}}warn{{/if}}">
        <i class="fa-solid {{#if sources.adventureImported}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
        {{localize "UKM.Setup.AdventureImported"}}
      </li>
      <li class="{{#if kingdomActive}}ok{{else}}warn{{/if}}">
        <i class="fa-solid {{#if kingdomActive}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
        {{localize "UKM.Setup.KingdomActive"}}
        {{#unless kingdomActive}}<a data-action="openKingdom">{{localize "UKM.Setup.OpenPartySheet"}}</a>{{/unless}}
      </li>
      <li class="{{#if storyImported}}ok{{else}}warn{{/if}}">
        <i class="fa-solid {{#if storyImported}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
        {{localize "UKM.Setup.StoryImported"}}
        {{#if sources.adventureImported}}<a data-action="openImport">{{#if storyImported}}{{localize "UKM.Setup.Reimport"}}{{else}}{{localize "UKM.Setup.Import"}}{{/if}}</a>{{/if}}
      </li>
    </ul>
  </section>

  <section>
    <h3>{{localize "UKM.Setup.Table"}}</h3>
    <div class="form-group">
      <label>{{localize "UKM.Settings.TapTreasury.Name"}}</label>
      <select name="tapTreasury">{{selectOptions tapChoices selected=tapTreasury localize=true}}</select>
      <p class="hint">{{localize "UKM.Settings.TapTreasury.Hint"}}</p>
    </div>
  </section>

  <section>
    <h3>{{localize "UKM.Setup.Founding"}}</h3>
    <p class="hint">{{localize "UKM.Setup.FoundingHint"}}</p>
    {{#if founding.done}}
      <p>{{founding.picked}} · <a data-action="resetFounding">{{localize "UKM.Setup.FoundingReset"}}</a></p>
    {{else}}
      {{#each founding.slots}}
        <div class="form-group">
          <label>{{localize "UKM.Setup.FoundingPick" n=number}}</label>
          <select name="founding.{{index}}">
            <option value="">{{localize "UKM.Setup.None"}}</option>
            {{selectOptions @root.founding.choices selected=selected}}
          </select>
        </div>
      {{/each}}
    {{/if}}
  </section>

  <section>
    <h3>{{localize "UKM.Start.Title"}}</h3>
    {{#if suggestStart}}<p class="ukm-notice">{{localize "UKM.Start.Nudge" level=partyLevel}}</p>{{else}}<p class="hint">{{localize "UKM.Start.Hint"}}</p>{{/if}}
    <p><button type="button" data-action="openMidCampaign"><i class="fa-solid fa-forward"></i> {{localize "UKM.Start.Open"}}</button></p>
  </section>

  <section>
    <h3>{{localize "UKM.Setup.Seats"}}</h3>
    <p class="hint">{{localize "UKM.Setup.SeatsHint"}}</p>
    <p class="hint">
      {{#if showAllActors}}{{localize "UKM.Setup.ShowingAll"}}{{else}}{{localize "UKM.Setup.ShowingCompanions"}}{{/if}}
      <a data-action="toggleActors">{{#if showAllActors}}{{localize "UKM.Setup.ShowFewer"}}{{else}}{{localize "UKM.Setup.ShowAll"}}{{/if}}</a>
    </p>
    {{#unless kingdomActive}}<p class="ukm-notice">{{localize "UKM.Setup.SeatsNeedKingdom"}}</p>{{/unless}}
    <table class="ukm-seats">
      <thead>
        <tr>
          <th>{{localize "UKM.Setup.Seat"}}</th>
          <th>{{localize "UKM.Setup.Holder"}}</th>
          <th>{{localize "UKM.Setup.Companion"}}</th>
          <th>{{localize "UKM.Setup.Supervisor"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each seats}}
        <tr>
          <td>{{label}}</td>
          <td>
            <select name="seats.{{seat}}.holder">
              <option value="">{{localize "UKM.Setup.None"}}</option>
              {{#each @root.holderGroups}}
                <optgroup label="{{label}}">{{selectOptions choices selected=../holder}}</optgroup>
              {{/each}}
            </select>
          </td>
          <td>
            <select name="seats.{{seat}}.companion">
              <option value="">{{localize "UKM.Setup.None"}}</option>
              {{selectOptions @root.companionChoices selected=companion}}
            </select>
          </td>
          <td>
            <select name="seats.{{seat}}.supervisor">
              <option value="">{{localize "UKM.Setup.None"}}</option>
              {{selectOptions @root.supervisorChoices selected=supervisor}}
            </select>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <p class="hint">{{localize "UKM.Hired.Hint"}}</p>
  </section>

  <section>
    <h3>{{localize "UKM.Attitude.Heading"}}</h3>
    <p class="hint">{{localize "UKM.Attitude.Hint"}}</p>
    <div class="ukm-attitudes">
      {{#each companionRows}}
        <div class="form-group">
          <label>{{name}}</label>
          <select name="attitudes.{{id}}">{{selectOptions @root.attitudeChoices selected=attitude localize=true}}</select>
        </div>
      {{/each}}
    </div>
  </section>
</div>
