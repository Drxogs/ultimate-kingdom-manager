<section class="tab ukm-overview {{tab.cssClass}}" data-tab="overview" data-group="primary">
  {{#unless kingdomActive}}
    <p class="ukm-notice">{{localize "UKM.Manager.NoKingdom"}}</p>
  {{/unless}}

  {{#if debt.amount}}
    <p class="ukm-notice ukm-debt-line">
      <span class="ukm-debt" data-tooltip="{{localize "UKM.Tap.DebtHint"}}">{{localize "UKM.Tap.Owed" debt=debt.amount}}</span>
      {{#if canRepay}}<button type="button" class="ukm-rank-up" data-action="repayDebt"><i class="fa-solid fa-coins"></i> {{localize "UKM.Tap.Repay"}}</button>{{/if}}
    </p>
  {{/if}}

  <div class="ukm-pressure">
    {{#each kingdom.ruin}}
      <div class="ukm-meter ukm-ruin">
        <label>{{label}}</label>
        <div class="ukm-bar small"><span style="width: {{percent}}%"></span></div>
        <span class="ukm-value">{{value}} / {{max}}{{#if penalty}} (−{{penalty}}){{/if}}</span>
      </div>
    {{/each}}
  </div>

  <header class="ukm-major">{{localize "UKM.Manager.RealmStats"}}</header>
  <ol class="ukm-stats">
    {{#each stats}}
      <li class="ukm-stat {{#if ready}}ready{{/if}}" data-stat="{{key}}">
        <div class="ukm-stat-head">
          <strong>{{label}}</strong>
          <span class="hint">{{seat}} · {{skills}}</span>
        </div>
        <div class="ukm-stat-rank">
          <span>{{localize "UKM.Manager.Rank"}} {{rank}}</span>
          {{#if bonus}}<span class="ukm-tag">{{ukmSigned bonus}}</span>{{/if}}
          <button type="button" class="ukm-icon" data-action="previewRankUp" data-tooltip="{{localize "UKM.Rank.Preview"}}"><i class="fa-solid fa-eye"></i></button>
        </div>
        <div class="ukm-bar"><span style="width: {{progress.percent}}%"></span></div>
        <span class="hint">
          {{progress.value}} / {{progress.max}}
          {{#if routine}} · <span data-tooltip="{{localize "UKM.Manager.RoutineHint"}}">{{localize "UKM.Manager.Routine" n=routine}}</span>{{else}} · {{localize "UKM.Manager.NoRoutine"}}{{/if}}
          {{#if ready}} · {{localize "UKM.Manager.RankReady"}}{{else}}{{#if atCap}} · {{localize "UKM.Manager.AtCap"}}{{/if}}{{/if}}
        </span>
        {{#if rankUpWorking}}
          <span class="ukm-working"><i class="fa-solid fa-hammer"></i> {{localize "UKM.Rank.Underway" days=rankUpDays}}</span>
          {{#if @root.isGM}}<button type="button" class="ukm-rank-up" data-action="finishRankUp" data-tooltip="{{localize "UKM.Rank.FinishNow"}}"><i class="fa-solid fa-forward"></i></button>{{/if}}
        {{/if}}
        {{#if rankUpChoosing}}<span class="ukm-working"><i class="fa-solid fa-scroll"></i> {{localize "UKM.Rank.Choosing"}}</span>{{/if}}
        {{#if canBegin}}<button type="button" class="ukm-rank-up" data-action="beginRankUp"><i class="fa-solid fa-arrow-up"></i> {{localize "UKM.Rank.Begin" cost=cost}}</button>{{/if}}
        {{#if canChoose}}<button type="button" class="ukm-rank-up" data-action="chooseRankUp"><i class="fa-solid fa-scroll"></i> {{localize "UKM.Rank.Choose"}}</button>{{/if}}
      </li>
    {{/each}}
  </ol>

  <header class="ukm-major">{{localize "UKM.Ambition.Heading"}}</header>
  <ol class="ukm-stats ukm-ambitions">
    {{#each ambitions}}
      <li class="ukm-stat {{#if complete}}ready{{/if}}">
        <div class="ukm-stat-head">
          <strong>{{title}}</strong>
          <span class="hint">{{seatLabel}} · {{reached}}/{{total}}</span>
        </div>
        {{#if complete}}
          <span class="hint">{{localize "UKM.Ambition.Complete"}}</span>
        {{else}}
          <span>{{goal}}</span>
          <div class="ukm-bar"><span style="width: {{percent}}%"></span></div>
          <span class="hint">{{value}} / {{target}} · {{localize "UKM.Ambition.Reward" reward=reward}}</span>
        {{/if}}
      </li>
    {{/each}}
  </ol>

  <p class="ukm-handbook-link"><button type="button" data-action="openHandbook"><i class="fa-solid fa-book-open-reader"></i> {{localize "UKM.Handbook.Open"}}</button></p>

  {{#if isGM}}
    <header class="ukm-major">{{localize "UKM.Manager.GmTasks"}}{{#if openTasks}} <span class="ukm-tag">{{openTasks}}</span>{{/if}}</header>
    {{#if gmTasks.length}}
      <ul class="ukm-tasks">
        {{#each gmTasks}}
          <li class="ukm-task {{#if done}}done{{/if}}" data-task="{{id}}">
            <button type="button" class="ukm-check" data-action="toggleTask"><i class="fa-regular {{#if done}}fa-square-check{{else}}fa-square{{/if}}"></i></button>
            <span class="ukm-task-text">{{text}}{{#if cardName}} <span class="hint">— {{cardName}}, {{date}}</span>{{/if}}</span>
            {{#if canFocus}}<button type="button" data-action="focusHex" data-tooltip="{{localize "UKM.Card.Focus"}}"><i class="fa-solid fa-map-location-dot"></i></button>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="hint">{{localize "UKM.Manager.NoTasks"}}</p>
    {{/if}}

    <footer class="ukm-gm-tools">
      <button type="button" data-action="openSetup"><i class="fa-solid fa-gear"></i> {{localize "UKM.Manager.Setup"}}</button>
      <button type="button" data-action="openImport"><i class="fa-solid fa-book-open"></i> {{#if storyImported}}{{localize "UKM.Setup.Reimport"}}{{else}}{{localize "UKM.Setup.Import"}}{{/if}}</button>
      <button type="button" data-action="toggleBetweenSessions">
        <i class="fa-solid {{#if betweenSessions}}fa-door-open{{else}}fa-door-closed{{/if}}"></i>
        {{#if betweenSessions}}{{localize "UKM.Manager.BetweenOn"}}{{else}}{{localize "UKM.Manager.BetweenOff"}}{{/if}}
      </button>
      <button type="button" data-action="drawEvents"><i class="fa-solid fa-layer-group"></i> {{localize "UKM.Manager.DrawNow"}}</button>
      <button type="button" data-action="drawAudience"><i class="fa-solid fa-comments"></i> {{localize "UKM.Manager.DrawAudience"}}</button>
      <button type="button" data-action="storyEvent"><i class="fa-solid fa-book-skull"></i> {{localize "UKM.Manager.StoryEvents"}}</button>
      <button type="button" data-action="drawMatter"><i class="fa-solid fa-inbox"></i> {{localize "UKM.Manager.DrawMatter"}}</button>
    </footer>
  {{/if}}
</section>
