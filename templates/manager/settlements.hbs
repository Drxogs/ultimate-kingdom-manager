<section class="tab ukm-settlements {{tab.cssClass}}" data-tab="settlements" data-group="primary">
  {{#unless hasCapital}}
    <div class="ukm-first-step">
      <i class="fa-solid fa-chess-rook"></i>
      <div>
        <h3>{{localize "UKM.Settlement.FirstStepTitle"}}</h3>
        <p>{{localize "UKM.Settlement.FirstStep"}}</p>
        {{#if canFoundCapital}}
          <button type="button" data-action="foundCapital"><i class="fa-solid fa-flag"></i> {{localize "UKM.Settlement.FoundCapital"}}</button>
        {{else}}
          <p class="hint">{{localize "UKM.Settlement.FirstStepWait"}}</p>
        {{/if}}
      </div>
    </div>
  {{/unless}}
  {{#each settlements}}
    <article class="ukm-settlement" data-settlement="{{id}}">
      <header class="ukm-major">
        {{#if capital}}<i class="fa-solid fa-crown" data-tooltip="{{localize "UKM.Settlement.Capital"}}"></i>{{/if}}
        {{name}}
        <span class="ukm-settlement-type">{{typeLabel}}</span>
        <span class="controls">
          {{#if hexKey}}<button type="button" class="ukm-icon" data-action="focusHex" data-hex="{{hexKey}}" data-tooltip="{{localize "UKM.Card.Focus"}}"><i class="fa-solid fa-map-location-dot"></i></button>{{/if}}
          {{#if @root.isGM}}
            {{#unless capital}}<button type="button" class="ukm-icon" data-action="makeCapital" data-tooltip="{{localize "UKM.Settlement.MakeCapital"}}"><i class="fa-solid fa-crown"></i></button>{{/unless}}
            <button type="button" class="ukm-icon {{#if waterside}}on{{/if}}" data-action="toggleWaterside" data-tooltip="{{localize "UKM.Settlement.ToggleWater"}}"><i class="fa-solid fa-water"></i></button>
            <button type="button" class="ukm-icon" data-action="deleteSettlement" data-tooltip="{{localize "UKM.Settlement.Delete"}}"><i class="fa-solid fa-trash"></i></button>
          {{/if}}
        </span>
      </header>
      <div class="ukm-panorama">{{{panorama}}}</div>
      <div class="ukm-settlement-facts row">
        <span><i class="fa-solid fa-wheat-awn"></i> {{localize "UKM.Track.FoodNeed" n=consumption}}</span>
        {{#if waterside}}<span><i class="fa-solid fa-water"></i> {{localize "UKM.Settlement.Waterside"}}</span>{{/if}}
        {{#unless onMap}}<span class="hint">{{localize "UKM.Settlement.NotOnMap"}}</span>{{/unless}}
        {{#if missing}}<span class="ukm-urgent"><i class="fa-solid fa-triangle-exclamation"></i> {{missing}}</span>{{else}}<span class="hint">{{localize "UKM.Track.MissingNone"}}</span>{{/if}}
      </div>
      {{#if bonuses.length}}<p class="ukm-settlement-bonuses"><span class="ukm-facts-head">{{localize "UKM.Track.Bonuses"}}</span> {{#each bonuses}}<span class="ukm-tag">{{this}}</span> {{/each}}</p>{{/if}}
      <div class="ukm-tracks">
        {{#each tracks}}
          <div class="ukm-track {{#if now}}built{{else}}unbuilt{{/if}} {{#if pinnacle}}pinnacle{{/if}}" data-track="{{id}}" data-stage="{{stage}}">
            <div class="ukm-track-name">
              <strong>{{name}}</strong>
              <span class="hint">{{seatLabel}}{{#if basic}} · {{localize "UKM.Track.Basic"}}{{/if}}</span>
            </div>
            <div class="ukm-track-now">
              {{#if now}}
                <p><span class="ukm-track-stage">{{stageLabel}}</span> <strong>{{now.name}}</strong></p>
                <p class="ukm-track-desc">{{now.description}}</p>
                <p class="ukm-track-gives">{{now.gives}}</p>
              {{else}}
                <p class="hint">{{localize "UKM.Track.None"}}</p>
              {{/if}}
            </div>
            <div class="ukm-track-next">
              {{#if next}}
                <p><span class="ukm-track-stage">{{#if nextIsPinnacle}}{{localize "UKM.Track.Pinnacle"}}{{else}}{{localize "UKM.Track.Next"}}{{/if}}</span> <strong>{{next.name}}</strong></p>
                <p class="ukm-track-gives">{{next.gives}}</p>
                {{#if cost}}<p class="hint">{{cost}}</p>{{/if}}
              {{/if}}
              {{#if underway}}
                <p class="ukm-track-underway"><i class="fa-solid fa-hammer"></i> {{localize "UKM.Track.Underway"}}</p>
              {{else if canBuild}}
                <button type="button" class="ukm-desk-action" data-action="developTrack"><i class="fa-solid fa-trowel-bricks"></i> {{buildLabel}}</button>
              {{else if blocked}}
                <p class="hint">{{blocked}}</p>
              {{/if}}
              {{#if @root.isGM}}
                <span class="ukm-track-gm">
                  {{#if canDown}}<button type="button" class="ukm-icon" data-action="gmTrackStage" data-step="-1" data-tooltip="{{localize "UKM.Track.GmDown"}}"><i class="fa-solid fa-minus"></i></button>{{/if}}
                  {{#if canUp}}<button type="button" class="ukm-icon" data-action="gmTrackStage" data-step="1" data-tooltip="{{localize "UKM.Track.GmUp"}}"><i class="fa-solid fa-plus"></i></button>{{/if}}
                </span>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </article>
  {{else}}
    {{#if hasCapital}}<p class="hint">{{localize "UKM.Settlement.Empty"}}</p>{{/if}}
  {{/each}}
</section>
